### Метод для авторизации
POST http://localhost:8080/api/v1/auth/login/
Content-Type: application/json

{
  "email": "annten1@mail.com",
  "password": "SecurePass456!"
}

> {%
    client.global.set("access_token", response.body.access_token);
%}

### Метод для получения данных о профиле
GET http://localhost:8080/api/v1/profile/
Set-Cookie: access_token=eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJsb2xpazEiLCJpYXQiOjE3NDk4NDMyMzMsImV4cCI6MTc0OTg1MTg3M30.4ZnN3NB3pmrfbzZibDIeOEwRXDJIzFWj4msCq73qciQ; Max-Age=60480; Expires=Sat, 14 Jun 2025 12:21:53 GMT; Path=/; HttpOnly

### Идентификатор профиля другого пользователя
@foreignProfileId=

### Метод для получения профиля другого пользователя по ID
GET http://localhost:8080/api/v1/profile/{{foreignProfileId}}/
Set-Cookie: access_token=eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJsb2xpazEiLCJpYXQiOjE3NDk4NDQwMjQsImV4cCI6MTc0OTg1MjY2NH0.ZyijeFvs6CNv2MdkB8SgQG8HJIW9wwtn_0saUJf_Ty0; Max-Age=60480000; Expires=Fri, 14 May 2027 19:47:04 GMT; Path=/; HttpOnly
Set-Cookie: refresh_token=eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJsb2xpazEiLCJpYXQiOjE3NDk4NDQwMjQsImV4cCI6MTc0OTkwNDUwNH0.zIoaIj_Wgy0t1y709IfZQh_W9E_Xabm58x62CefupBU; Max-Age=60480000; Expires=Fri, 14 May 2027 19:47:04 GMT; Path=/; HttpOnly

