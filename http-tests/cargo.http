@baseUrl = http://localhost:8080/api/v1/cargos

### Метод для регистрации компании
POST http://localhost:8080/api/v1/auth/register/
Content-Type: application/json

{
  "username": "lolik",
  "email": "annten@mail.com",
  "password": "SecurePass456!",
  "legalType": "INDIVIDUAL",
  "role": "CUSTOMER"
}

### Метод для авторизации
POST http://localhost:8080/api/v1/auth/login/
Content-Type: application/json

{
  "email": "annten@mail.com",
  "password": "SecurePass456!"
}

> {%
    client.global.set("access_token", response.body.access_token);
%}

### Метод для создания груза
POST {{baseUrl}}//
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "name": "Box",
  "description": "Большая коробка",
  "weight": 10,
  "volume": 100,
  "loadType": "Задняя",
  "unloadType": "Задняя",
  "bodyType": "Тент",
  "dimensions": {
    "length": 10,
    "width": 5,
    "height": 20
  },
  "route": {
    "from": "New York",
    "to": "Los Angeles"
  },
  "price": 99.99,
  "typePay": "НДС",
  "readyDate": "2025-05-22",
  "deliveryDate": "2025-06-01"
}

### Получение списка груза [INTERNAL, EXTERNAL, HISTORY]
GET {{baseUrl}}/general/?cargoCategory=INTERNAL&pageNumber=1&pageSize=5
Authorization: Bearer {{access_token}}
Accept: application/json

###
@cargo_uuid = e423d1e1-1821-48ef-b41a-8f8ecf89b036

### Получение деталей груза
GET {{baseUrl}}/{{cargo_uuid}}/
Authorization: Bearer {{access_token}}
Accept: application/json

### Публикация записи
PATCH {{baseUrl}}/{{cargo_uuid}}/publish
Authorization: Bearer {{access_token}}
Accept: application/json

### Снятие записи с публикации
PATCH {{baseUrl}}/{{cargo_uuid}}/draft
Authorization: Bearer {{access_token}}
Accept: application/json

### Обновление записи о грузе
PATCH {{baseUrl}}/{{cargo_uuid}}/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "name": "Box",
  "description": "Большая коробка",
  "weight": 10,
  "volume": 100,
  "loadType": "Задняя",
  "unloadType": "Задняя",
  "bodyType": "Тент",
  "dimensions": {
    "length": 10,
    "width": 5,
    "height": 20
  },
  "route": {
    "from": "New York",
    "to": "Los Angeles"
  },
  "price": 100,
  "typePay": "НДС",
  "readyDate": "2025-05-22",
  "deliveryDate": "2025-06-01"
}

### Удаление записи груза
DELETE {{baseUrl}}/{{cargo_uuid}}/
Authorization: Bearer {{access_token}}
Content-Type: application/json

### Запрос на получение списка записей грузов
POST {{baseUrl}}/search/?pageNumber=1&pageSize=5
Content-Type: application/json
Accept: application/json

{
    "weightFrom": 10,
    "weightTo": 2000,
    "volumeFrom": 10,
    "volumeTo": 150,
    "loadType": "Задняя",
    "unloadType": "Боковая",
    "priceFrom": 5000.00,
    "priceTo": 15000.00,
    "bodyType": "Тентованный",
    "readyDate": "2025-02-15",
    "route": {
    "from": "Москва",
    "to": "Санкт-Петербург"
    },
    "dimensions": {
    "length": 300,
    "width": 200,
    "height": 250
    }
}
