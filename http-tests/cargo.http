@baseUrl = http://localhost:8080/api/v1/cargos
@cargo_uuid = ab053c05-57fe-4d60-8a21-1a921cbe7132

### Метод для регистрации компании
POST http://localhost:8080/api/v1/auth/register/
Content-Type: application/json

{
  "username": "lolik",
  "email": "annten@mail.com",
  "password": "SecurePass456!",
  "legalType": "INDIVIDUAL",
  "role": "CUSTOMER"
}

### Метод для авторизации
POST http://localhost:8080/api/v1/auth/login/
Content-Type: application/json

{
  "email": "annten@mail.com",
  "password": "SecurePass456!"
}

> {%
    client.global.set("access_token", response.body.access_token);
%}

### Метод для создания груза
POST {{baseUrl}}//
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "name": "Box",
  "description": "Большая коробка",
  "weight": 10,
  "volume": 100,
  "loadType": "Задняя",
  "unloadType": "Задняя",
  "bodyType": "Тент",
  "dimensions": {
    "length": 10,
    "width": 5,
    "height": 20
  },
  "route": {
    "from": "New York",
    "to": "Los Angeles"
  },
  "price": 99.99,
  "typePay": "НДС",
  "readyDate": "2025-05-22",
  "deliveryDate": "2025-06-01"
}

### Получение списка груза
GET {{baseUrl}}/general/?visibilityStatus=DRAFT&pageNumber=0&pageSize=10
Authorization: Bearer {{access_token}}
Accept: application/json

### Получение деталей груза
GET {{baseUrl}}/{{cargo_uuid}}/
Authorization: Bearer {{access_token}}
Accept: application/json
