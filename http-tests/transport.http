### Метод для создания транспорта
POST {{baseUrl}}//
Authorization: {{authToken}}
Content-Type: application/json

{
  "type": "Грузовик",
  "brand" : "Volvo",
  "model": "FH16",
  "year": "2022",
  "transportNumber": "43kl43",
  "liftingCapacity": 10000,
  "volume": 50,
  "loadType": "Верхняя",
  "unloadType": "Задняя",
  "bodyType": "Реф",
  "route": {
    "from": "Москва",
    "to": "Санкт-Петербург"
  },
  "trailerDetails": {
    "dimensions": {
    "length": 10,
    "width": 2.5,
    "height": 3
    },
    "volume": 10,
    "trailerNumber": "43kl43"
  },
  "price": 5000.00,
  "typePay": "Предоплата",
  "readyDate": "2025-02-28",
  "driver": "",
  "status": "HIDDEN",
  "photos": [
    {
      "id": "{{photo_uuid}}"
    }
  ]
}

### Получение деталей транспорта
GET {{baseUrl}}/{{transport_uuid}}/
Authorization: {{authToken}}

